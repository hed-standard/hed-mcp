{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run test:ci *)",
      "Bash(npm run test:coverage *)",
      "Bash(npm run build *)",
      "Bash(npm ci)",
      "Bash(npx jest *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(node --version)",
      "Bash(uvx typos *)",
      "Bash(uvx --native-tls typos *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -vv)",
      "Bash(git ls-files *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.envrc)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm publish *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
